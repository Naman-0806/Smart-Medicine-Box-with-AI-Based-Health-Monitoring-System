# Firebase Web API Key (Required for normal users: Authentication & Firestore Database)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Project ID (Optional: auto-detected from Web API token, or provide explicitly)
# FIREBASE_PROJECT_ID=smart-medicine-box-51870

# Path to the Firebase Service Account private key JSON file (Optional: for Admin SDK only, not required for normal users)
# FIREBASE_SERVICE_ACCOUNT_PATH=path/to/your/firebase-service-account-key.json

